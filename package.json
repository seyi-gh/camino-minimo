{
  "name": "camino-minimo",
  "version": "0.1.0",
  "description": "Problema del camino minimo en un grafo ponderado - MA475 Matematica Computacional",
  "type": "module",
  "scripts": {
    "verificar": "node --experimental-strip-types pruebas/verificar.ts",
    "verificar:ui": "node --experimental-strip-types pruebas/interfaz.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verificar:sistema": "node --experimental-strip-types pruebas/sistema.ts",
    "datos": "datos/.venv/bin/python datos/construir_red.py datos/crudo/peru-latest.osm.pbf public/datos && node --experimental-strip-types datos/preparar_datos.ts",
    "verificar:simulacion": "node --experimental-strip-types pruebas/simulacion.ts"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.7.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0"
  }
}
